<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
                               https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="motis.client" class="Sneakyx\MotisPhpClient\MotisClient" public="false">
            <argument>%motis.base_url%</argument>
        </service>

        <service id="Sneakyx\MotisPhpClient\MotisClient" alias="motis.client" />

        <service id="motis.manager" class="Sneakyx\MotisSymfonyClient\MotisManager" public="true">
            <argument type="service" id="motis.client" />
        </service>

        <service id="Sneakyx\MotisSymfonyClient\MotisManager" alias="motis.manager" />
    </services>
</container>
